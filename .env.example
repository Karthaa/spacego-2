# SpaceGo Environment Variables (Placeholders Only)
# Copy to .env.local for `next dev`; set the same values in intent.yaml for
# stage/prod builds. These are public build-time values, not Worker secrets.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-placeholder

# Legacy fallback still supported by src/lib/supabase/config.ts:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# --- Maps and location search (all optional) ---
# Without any of these, /discover uses free OpenFreeMap tiles and the built-in
# list of areas for suggestions.
# MapTiler basemap in the browser (a public, domain-restricted key):
# NEXT_PUBLIC_MAPTILER_KEY=
# Any MapLibre style URL, overriding the default basemap:
# NEXT_PUBLIC_MAP_STYLE_URL=
# Server-only MapTiler key for /api/geocode (address search). Set it as a
# Worker secret, never with a NEXT_PUBLIC_ prefix:
# MAPTILER_API_KEY=
