# SpaceGo environment variables (placeholders only, never real values)
# Copy to .env.local for `next dev`. Stage and production set the same names
# per environment in intent.yaml. Every NEXT_PUBLIC_* value is built into the
# JavaScript that visitors download, so none of them may be secret.
#
# Leave the two Supabase values unset to run in demo mode: sample listings in
# the browser and no sign-in.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-placeholder

# Legacy fallback still supported by src/lib/supabase/config.ts:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# --- Site ---
# Public origin of this deployment: metadata and canonical links, keeping the
# test site out of search engines, and the host that sign-in redirects go to.
# Update it whenever the site moves to a new domain.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Maps and location search (all optional) ---
# Without any of these, /discover uses free OpenFreeMap tiles and the built-in
# list of areas for suggestions.
# MapTiler basemap in the browser (a public, domain-restricted key):
# NEXT_PUBLIC_MAPTILER_KEY=
# Any MapLibre style URL, overriding the default basemap. If its tiles come
# from other hosts, add them to connect-src in src/lib/security-headers.ts.
# NEXT_PUBLIC_MAP_STYLE_URL=
# Server-only MapTiler key for /api/geocode (address search). Set it as a
# Worker secret, never with a NEXT_PUBLIC_ prefix:
# MAPTILER_API_KEY=

# --- Content-Security-Policy (build time, not secret) ---
# Production builds report the full CSP without enforcing it. Set to
# "enforce" once a stage deploy's browser console shows no CSP violations.
# CSP_MODE=enforce
