# Line endings: LF in the repository and in every checkout, Windows included,
# so scripts, SQL and lockfiles stay byte-for-byte the same on every machine.
* text=auto eol=lf

# Windows-only scripts, if any are added, keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never convert, never diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# Collapse the generated lockfile in GitHub's diff view.
package-lock.json linguist-generated=true
